; Detective Files — the one global Theme. Art contract: docs/art-bible.md §4.
; No per-node style overrides except via scripts/ui/df_ui.gd role helpers
; (typography roles + primary-button variation, both documented there).
; Palette: midnight #12151D, charcoal #1E2028, panel #292C38, input #171A22,
; border #3A3E52, hover #313445, purple #8B7BC7, purple_dim #6E5FA8,
; gold #D9A441, gold_bright #E8BE5A, primary #E9E2D2, secondary #B0AEBE,
; disabled #6E7180, error #E07A6B, success #8FC07A.

[gd_resource type="Theme" format=3]

[ext_resource type="FontFile" path="res://assets/fonts/SpecialElite-Regular.ttf" id="1"]
[ext_resource type="FontFile" path="res://assets/fonts/IBMPlexSans-Variable.ttf" id="2"]

[sub_resource type="FontVariation" id="semibold"]
base_font = ExtResource("2")
variation_opentype = {
"wght": 600.0
}

[sub_resource type="StyleBoxFlat" id="card"]
bg_color = Color(0.16078, 0.17255, 0.21961, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
