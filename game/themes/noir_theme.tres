[resource]
default_font = ExtResource("2")
default_font_size = 16

; --- Labels: primary body text by default. ---
Label/colors/font_color = Color(0.91373, 0.88627, 0.82353, 1)
Label/colors/font_disabled_color = Color(0.43137, 0.44314, 0.50196, 1)
Label/fonts/font = ExtResource("2")

; --- Buttons: the quiet secondary style is the engine default.
; --- The gold primary variation is applied ONLY by DFUI.make_primary(),
; --- which reads the PrimaryButton/* entries below from this same Theme. ---
Button/colors/font_color = Color(0.6902, 0.68235, 0.7451, 1)
Button/colors/font_hover_color = Color(0.91373, 0.88627, 0.82353, 1)
Button/colors/font_hover_pressed_color = Color(0.91373, 0.88627, 0.82353, 1)
Button/colors/font_pressed_color = Color(0.91373, 0.88627, 0.82353, 1)
Button/colors/font_disabled_color = Color(0.43137, 0.44314, 0.50196, 1)
Button/colors/font_focus_color = Color(0.6902, 0.68235, 0.7451, 1)
Button/font_sizes/font_size = 16
Button/fonts/font = SubResource("semibold")
Button/styles/disabled = SubResource("btn_disabled")
Button/styles/focus = SubResource("btn_focus")
Button/styles/hover = SubResource("btn_sec_hover")
Button/styles/normal = SubResource("btn_sec_normal")
Button/styles/pressed = SubResource("btn_sec_pressed")

PrimaryButton/colors/font_color = Color(0.85098, 0.64314, 0.2549, 1)
