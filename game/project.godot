; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Detective Files"
config/description="A single-player 2D noir detective mystery. Server-authoritative: the Go backend owns all game state."
run/main_scene="res://scenes/startup.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Session="*res://scripts/state/session.gd"
ApiClient="*res://scripts/api/api_client.gd"
Nav="*res://scripts/state/nav.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://themes/noir_theme.tres"

[rendering]

environment/defaults/default_clear_color=Color(0.07059, 0.08235, 0.11373, 1)
